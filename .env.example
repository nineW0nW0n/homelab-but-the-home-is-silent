# Copy to .env, fill real values. Never commit .env.
# GitHub Actions uses repo Secrets/Variables, not this file. This is for local tooling only.

# --- Cloudflare ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=
# vps01's own dedicated tunnel (booking.maybeit.work). NOT shared with the
# above. One tunnel token = one interchangeable connector pool per node.
CLOUDFLARE_TUNNEL_TOKEN_VPS01_BOOKING=
# vps02's own dedicated tunnel (Netdata metrics). NOT shared with vps00's
# or vps01's tokens above.
CLOUDFLARE_TUNNEL_TOKEN_VPS02_METRICS=
CLOUDFLARE_ZONE=maybeit.work
# CLOUDFLARE_TUNNEL_ID and CLOUDFLARE_ZONE are reference values for manual
# dashboard/CLI work -- nothing in this repo reads them.

# --- vps00 ---
VPS00_HOST=
VPS00_SSH_USER=deploy
VPS00_SSH_PORT=22

# --- vps01 ---
VPS01_HOST=
VPS01_SSH_USER=deploy
VPS01_SSH_PORT=22

# --- vps02 ---
VPS02_HOST=
VPS02_SSH_USER=deploy
VPS02_SSH_PORT=22

# --- SSH (CI deploy) ---
# Private keys go in GitHub Secrets as SSH_PRIVATE_KEY_VPS00 / _VPS01 /
# _VPS02, one key per node, never a shared one, and never in this file.
SSH_KNOWN_HOSTS=

# --- Cloudflare R2 (vps01 nightly backup) ---
# deploy.yml writes these into /opt/stacks/vps01/.r2.env; rclone reads them
# as RCLONE_CONFIG_R2_ACCESS_KEY_ID / _SECRET_ACCESS_KEY. Scope the token to
# Object Read & Write -- a wider one is not needed, see stacks/vps01/CLAUDE.md.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Netdata alerting (Telegram) ---
# Also written to vps01's .telegram.env, which check-backup-age.sh reads.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Netdata Cloud claim ---
# The SAME value on all three nodes: this identifies the Space, not the
# node, unlike a tunnel token. From Netdata Cloud -> Connect Nodes.
NETDATA_CLAIM_TOKEN=
NETDATA_CLAIM_ROOMS=

# --- Status Worker ---
# CF_ACCESS_* is the Cloudflare Access service token the Worker uses to
# reach the Access-gated Netdata endpoints. The Worker's non-secret config
# (NODE_HOSTS) lives in worker/status/wrangler.toml, not here.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Shared header value gating https://maybeit.work/debug (send it as
# x-debug-key). Generate with `openssl rand -hex 32`. If unset, /debug
# returns 404 to everyone -- it fails closed, it does not fall back to
# public.
DEBUG_KEY=
