# Copy to .env, fill real values. Never commit .env.
# GitHub Actions uses repo Secrets/Variables, not this file — this is for local tooling only.

# --- Dokploy ---
DOKPLOY_URL=https://dokploy.maybeit.work
DOKPLOY_API_TOKEN=

# --- Cloudflare ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_ZONE=maybeit.work

# --- vps00 ---
VPS00_HOST=
VPS00_SSH_USER=deploy
VPS00_SSH_PORT=22

# --- vps01 ---
VPS01_HOST=
VPS01_SSH_USER=deploy
VPS01_SSH_PORT=22

# --- vps02 ---
VPS02_HOST=
VPS02_SSH_USER=deploy
VPS02_SSH_PORT=22

# --- SSH (CI deploy) ---
# Private key goes in GitHub Secrets as SSH_PRIVATE_KEY, not here.
SSH_KNOWN_HOSTS=
