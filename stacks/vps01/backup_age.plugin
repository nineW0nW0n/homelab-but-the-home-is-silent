#!/bin/sh
# Netdata external plugin: age in hours of the last successful ezBookkeeping
# backup. Exists so a *stalled* backup raises an alarm — a failure-only
# notification never fires when cron itself stops running.
#
# Mounted into the Netdata container at
# /usr/libexec/netdata/plugins.d/backup_age.plugin and enabled in
# netdata.conf ([plugins] backup_age = yes). Netdata passes the update
# interval in seconds as $1.
set -eu

UPDATE_EVERY=${1:-60}
# Netdata mounts the host root at /host/root (read-only).
STAMP_FILE=/host/root/opt/stacks/vps01/backup/.last-success

printf 'CHART backup_age.ezbookkeeping "" "Age of last successful ezBookkeeping backup" "hours" backup backup_age line 90000 %s\n' "$UPDATE_EVERY"
printf 'DIMENSION age age absolute 1 1\n'

while true; do
    if [ -r "$STAMP_FILE" ]; then
        last=$(cat "$STAMP_FILE" 2>/dev/null || echo 0)
    else
        # No stamp yet (first deploy, or the backup has never succeeded).
        # Report a large age rather than nothing, so the alarm fires instead
        # of sitting silently undefined.
        last=0
    fi
    now=$(date +%s)
    if [ "$last" -gt 0 ]; then
        age_hours=$(( (now - last) / 3600 ))
    else
        age_hours=999
    fi
    printf 'BEGIN backup_age.ezbookkeeping\n'
    printf 'SET age = %s\n' "$age_hours"
    printf 'END\n'
    sleep "$UPDATE_EVERY"
done
