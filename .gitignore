# Secrets
# *.env catches .r2.env / .telegram.env, which .env.* does not match; .env.*
# still carries .env.local and friends.
.env.*
*.env
!.env.example
infra/inventory.yaml
*.pem
*.key
id_rsa*
*_rsa
cloudflared/*.json
!cloudflared/config.example.json

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Python (pre-commit venv)
.venv/
__pycache__/

# Logs
*.log

# Terraform (if added later)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Node (worker/status/)
node_modules/
.wrangler/
.dev.vars

# Claude Code local permission state -- machine-specific, never shared.
# Also keeps Biome from linting a file it does not own (vcs.useIgnoreFile).
.claude/settings.local.json

# graphify generated knowledge graph -- rebuild with /graphify, never committed.
# Also keeps Biome off its generated graph.html (vcs.useIgnoreFile).
graphify-out/
